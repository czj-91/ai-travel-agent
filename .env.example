# Copy this file to .env and fill in your own keys.
# IMPORTANT: keep .env ASCII-only. langgraph dev reads it with the OS default
# encoding (GBK on zh-CN Windows); non-ASCII characters crash it with
# UnicodeDecodeError.
#
# After editing .env you must restart the kernel / rerun the process:
# load_dotenv() does not override variables already present in the process.

# --- chat model ----------------------------------------------------------
# deepseek-chat (default, text only) or qwen3.5-plus (multimodal, needs the
# DASHSCOPE_* keys below)
TRAVEL_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- web search tool: Tavily --------------------------------------------
TAVILY_API_KEY=
SEARCH_TIMEOUT=15
SEARCH_RETRIES=2

# --- LangSmith tracing / Studio -----------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-travel

# --- service hardening --------------------------------------------------
# Requests per client IP per window; one /plan burns ~10-20k tokens, so this
# is the cost fuse. Set to 0 only for local single-user use.
RATE_LIMIT_PER_MIN=10
RATE_WINDOW_SECONDS=60
# Comma-separated CORS allowlist. Default is the local page only.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Optional shared secret. If set, every POST must carry X-Service-Token.
SERVICE_TOKEN=

# Model price per 1M tokens, used only for the cost badge in the web UI.
# Look up your provider's current price and fill it in; leave 0 to hide the badge
# (the app never guesses a price).
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0
